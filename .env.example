# =============================================================================
# .env.example  -  AI Predictive Maintenance System - platform configuration
# =============================================================================
# Copy this file to ".env" and fill in your OWN credentials.
# The real .env is git-ignored and must never be committed.
#
# The platform runs fully without any of these values: email and SMS simply
# stay in "simulated" mode and alerts are written to the audit log instead of
# being dispatched.
# =============================================================================

# --- Flask -------------------------------------------------------------------
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# --- Platform display name ---------------------------------------------------
PLATFORM_NAME=AI Maintenance Cockpit

# --- Email gateway (optional) ------------------------------------------------
# Set EMAIL_ENABLED=1 only after entering a working sender + app password.
# Gmail: enable 2-Step Verification, then create an App Password (16 chars).
EMAIL_ENABLED=0
PLATFORM_EMAIL=
PLATFORM_EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_DISPLAY_NAME=UltraTech Cement AI Maintenance System

# --- SMS gateway (optional, Twilio) ------------------------------------------
# Set SMS_ENABLED=1 only after entering your own Twilio trial credentials.
SMS_ENABLED=0
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
