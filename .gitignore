# Secrets - never commit. Real values go in the host's environment settings.
.env

# The trained model and the precomputed kiln analytics ARE committed on purpose.
# Serverless hosts have no build step that can run a training script, and
# training inside a request would exceed the function timeout. Both artefacts are
# produced from seeded generators, so they are reproducible.

# The database is never committed: it is recreated and re-seeded on every start.
instance/
*.db

# The generated datasets are committed on purpose: they are small, seeded and
# reproducible, and they document exactly what the model was trained on.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
